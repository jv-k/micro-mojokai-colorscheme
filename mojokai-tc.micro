color-link default          "#f8f8f2,#1c1c1c"

color-link selection        "#f8f8f2,#3f3452"
color-link divider          "#373737"
color-link message          "#f8f8f2,#5206d3"
color-link error-message    "#000000,#f4005f"
color-link scrollbar        "#6e7066,#4e4e4e"
color-link line-number      "#858585,#222222"
color-link current-line-number "#f8f8f2,#252525"
color-link cursor-line      "#252525"
color-link tabbar           "bold #1c1c1c,#919288"
color-link statusline       "#1c1c1c,#55564f"
color-link indent-char      "#505050,#1c1c1c"
# In help etc:
color-link special          "underline #a6e22e,#1c1c1c"
# Shebang etc:
color-link preproc          "#ff2d01,#1c1c1c"
# _________________________________________________________

# {}()[]
color-link symbol.brackets  "#ffd700,#1c1c1c"
color-link symbol.braces    "#da70d6,#1c1c1c"
color-link symbol.operator  "#f92672,#1c1c1c"
color-link symbol.punctuation "#6e7066,#1c1c1c"

color-link comment          "italic #6e7066,#1c1c1c"
color-link todo             "underline #98c47a,#1c1c1c"

color-link type             "#66d9ef,#1c1c1c"
color-link type.types       "italic #66d9ef,#1c1c1c"

color-link constant         "italic #ae81ff,#1c1c1c"
color-link constant.string  "#e6db74,#1c1c1c"
color-link constant.special "#f92672,#1c1c1c"
color-link constant.specialChar "#f4005f,#1c1c1c"
color-link constant.stringEscaped "#ae81ff,#1c1c1c"
color-link constant.tplLiterals.expression "#a6e22e,#1c1c1c"
color-link constant.quotes     "#6e7066,#1c1c1c"

color-link statement        "#f92672,#1c1c1c"
color-link statement.let    "italic #66d9ef,#1c1c1c"
color-link statement.var    "italic #66d9ef,#1c1c1c"
color-link statement.class  "italic #66d9ef,#1c1c1c"
color-link statement.const  "italic #66d9ef,#1c1c1c"
color-link statement.function "italic #66d9ef,#1c1c1c"

color-link identifier          "#66d9ef,#1c1c1c"
color-link identifier.class    "#66d9ef,#1c1c1c"
color-link identifier.const    "#ae81ff,#1c1c1c"
color-link identifier.function "bold #a6e22e,#1c1c1c"

color-link identifier.special  "underline #a6e22e,#1c1c1c"

# Optional overrides — commented out, so micro's defaults apply
# color-link diff-added       "#00af00"
# color-link diff-modified    "#ffaf00"
# color-link diff-deleted     "#d70000"
