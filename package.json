{
  "name": "micro-mojokai-theme",
  "version": "1.0.1",
  "private": true,
  "description": "Mojokai: a truecolor Monokai-style colorscheme for the micro editor",
  "scripts": {
    "copy": "d=\"${MICRO_CONFIG_HOME:-$HOME/.config/micro}\" && mkdir -p \"$d/colorschemes\" && cp mojokai-tc.micro \"$d/colorschemes/\"",
    "link": "d=\"${MICRO_CONFIG_HOME:-$HOME/.config/micro}\" && mkdir -p \"$d/colorschemes\" && ln -sf \"$PWD/mojokai-tc.micro\" \"$d/colorschemes/\"",
    "bump-release": "verbump --release --push origin",
    "screenshots": "./dev/screenshots.sh"
  },
  "keywords": [
    "micro",
    "colorscheme",
    "monokai",
    "truecolor"
  ],
  "author": "John Valai",
  "license": "ISC"
}
